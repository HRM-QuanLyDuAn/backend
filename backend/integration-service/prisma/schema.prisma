// Prisma schema — integration-service (Port 4005)
// Database hrm_integration trên Supabase Postgres riêng (single-tenant, không tenantId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id            String   @id @default(cuid())
  type          String   // leave | overtime | advance | shift_swap | work_supplement | other
  employeeId    String
  branchSlug    String?
  title         String
  content       String
  attachmentUrl String?
  status        String   @default("pending") // pending | approved | rejected
  reviewedBy    String?
  reviewNote    String?
  sourceShiftId String?
  targetShiftId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("requests")
}

model Notification {
  id               String   @id @default(cuid())
  targetEmployeeId String?  // null = toàn hệ thống broadcast
  branchSlug       String?
  title            String
  body             String
  isRead           Boolean  @default(false)
  metadata         Json?
  requestType      String?
  shiftName        String?
  shiftDate        String?
  shiftTime        String?
  shiftHours       String?
  senderName       String?
  senderRole       String?
  senderPhone      String?
  createdAt        DateTime @default(now())

  @@map("notifications")
}

model SoapGatewayConfig {
  id              String   @id @default("default")
  endpointUrl     String
  wsdlUrl         String
  serviceName     String
  port            Int      @default(8443)
  securityMode    String
  allowedIPs      String[]
  status          String   @default("unknown")
  lastPingTime    String?
  avgResponseTime String?

  @@map("soap_gateway_configs")
}

model News {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  author    String
  date      String   // DD-MM-YYYY
  tag       String
  tagTone   String   @default("primary") // danger | warning | success | primary | gray
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

model Regulation {
  id            String   @id @default(cuid())
  code          String
  title         String
  category      String
  summary       String
  content       String
  status        String   @default("hiệu lực") // hiệu lực | dự thảo | hết hiệu lực
  scope         String   @default("Toàn công ty")
  effectiveDate String   // DD-MM-YYYY
  expiryDate    String?
  author        String
  version       String   @default("1.0")
  pinned        Boolean  @default(false)
  attachments   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("regulations")
}

model WifiConfig {
  id        String   @id @default(cuid())
  ssid      String
  bssid     String
  branch    String   // slug chi nhánh, ví dụ HN-1, HN-2
  status    String   @default("hoạt động") // hoạt động | vô hiệu hóa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wifi_configs")
}
